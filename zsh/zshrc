# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="hanavi"

plugins=(
    git
    git-extras
    pyenv
    gitignore
    python
    cp
    colorize
    safe-paste
    zsh-autosuggestions
    common-aliases
    hanavi
)

source $ZSH/oh-my-zsh.sh

[ -f ~/.zsh_custom ] && . ~/.zsh_custom

source ~/.local/venv/bin/activate

# opencode
export PATH=/Users/james/.opencode/bin:$PATH
